data/raw_v4/generic_university/candidates.jsonl
reports/eval/lora_v4/**/predictions_*supp*.jsonl
reports/eval/lora_v4/**/supp_predictions_*.jsonl
# --- RunPod export 원본(어댑터 1GB) ---
reports/blade_v3_export/
reports/eval/stable_decoding/**/supp_predictions_*.jsonl

