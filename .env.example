BLADE_JWT_SECRET=demo-only-change-me
BLADE_TARGET_URL=http://127.0.0.1:9000
BLADE_DB_DSN=sqlite:///file:demo.db?mode=ro&uri=true
BLADE_ADMIN_URL=http://127.0.0.1:8100
BLADE_LLM_PROVIDER=ollama
BLADE_LLM_MODEL=qwen2.5:7b
# Set the key for the selected provider in the process environment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BLADE_FAIL_MODE=open
BLADE_CACHE_TTL=60
BLADE_POLICY_POLL_SEC=5
BLADE_OLLAMA_URL=http://127.0.0.1:11434

BLADE_SLACK_WEBHOOK=

BLADE_DISCORD_WEBHOOK=

# Phase 2: set true in both admin-api and proxy to opt in.
BLADE_PHASE2_ENABLED=false
BLADE_MODE_ENABLED=true
BLADE_OBSERVABILITY_ENABLED=true
BLADE_CONTROLLER_ENABLED=true

BLADE_REDIS_ENABLED=true
BLADE_REDIS_LOCAL_CACHE_ENABLED=true
BLADE_REDIS_URL=

BLADE_RAG_ENABLED=true
BLADE_RAG_KINDS=code,idiom
BLADE_EMBED_MODEL=intfloat/multilingual-e5-small
BLADE_CHROMA_PATH=.chroma
BLADE_MODEL_CACHE=.cache/models
BLADE_CVE_CORPUS=corpus/cve.jsonl
BLADE_ALERTS_ENABLED=true
BLADE_EXPLAIN_ENABLED=true
# Group background detection commits; bounded queue applies backpressure when full.
BLADE_DETECTION_BATCH_ENABLED=true
BLADE_DETECTION_STREAM_ENABLED=true
# Set the same namespace on proxy/admin when DB mount paths differ.
# Compose supplies a shared default; standalone uses a hash of BLADE_DB_DSN.
# BLADE_DETECTION_STREAM_NAMESPACE=blade
# Optional separate persistent Redis for detection delivery; defaults to BLADE_REDIS_URL.
# BLADE_DETECTION_REDIS_URL=redis://127.0.0.1:6379/0
BLADE_LOOKUP_BATCH_ENABLED=true
BLADE_CVE_ENABLED=true
BLADE_REANALYSIS_ENABLED=true
BLADE_REANALYSIS_OBSERVE_THRESHOLD=20
BLADE_REANALYSIS_MIN_REQUESTS=5
BLADE_REANALYSIS_MIN_SUBJECTS=3
BLADE_REANALYSIS_WOULD_BLOCK_RATIO=0.8
BLADE_REANALYSIS_POLL_SEC=5
NVD_API_KEY=
